{
  "name": "muse-video-studio",
  "version": "0.5.0",
  "private": true,
  "description": "Windows desktop queue for Muse image-to-video workflows",
  "main": "src/main.cjs",
  "author": "Muse Video Studio",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.cjs",
    "dist:win": "electron-builder --win portable --x64",
    "test:ui": "node test/ui-smoke.cjs",
    "test:merge": "node test/merge.test.cjs",
    "test:package": "node test/edit-package.test.cjs",
    "test:sessions": "node test/session-store.test.cjs",
    "test:browser-smoke": "node test/external-browser-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.musevideostudio.app",
    "productName": "Muse Video Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "MuseVideoStudio-${version}-Windows.exe",
      "signAndEditExecutable": false
    },
    "compression": "store"
  },
  "dependencies": {
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4"
  }
}
